index 0000000..061a3bc
--- /dev/null
+++ b/src/lib/api/buyer.ts
@@ -0,0 +1,402 @@
+// Buyer-side read client — direct PostgREST reads against Supabase tables
+// with the publishable anon key, same low-risk pattern as vendor-lookup.ts
+// and vendor-knowledge.ts (public RLS SELECT policies, qual: true). Every
+// buyer portal page reads through this instead of dummy-data.ts.
+//
+// Writes still go through the Yoxa workflow's own tools (save-buyer-
+// requirements, save-client-reality-profile, etc.) — this client only
+// mirrors what those tools have already persisted back into a shape the
+// existing UI components (which were built against dummy-data.ts) expect.
+
+import type {
+  Buyer,
+  CapabilityFrontierItem,
+  ClientRealityProfile,
+  ConversationMessage,
+  GapItem,
+  MeetingRequest,
+  RoiProjection,
+  SolutionMatch,
+  SolutionModel,
+  Vendor,
+} from "@/lib/types";
+
+const SUPABASE_URL = process.env.NEXT_PUBLIC_SUPABASE_URL;
+const SUPABASE_ANON_KEY = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY;
+
+async function restGet<T>(path: string): Promise<T> {
+  if (!SUPABASE_URL || !SUPABASE_ANON_KEY) throw new Error("Supabase is not configured.");
+  const res = await fetch(`${SUPABASE_URL}/rest/v1/${path}`, {
+    headers: { apikey: SUPABASE_ANON_KEY, Authorization: `Bearer ${SUPABASE_ANON_KEY}` },
+  });
+  if (!res.ok) throw new Error(`Supabase read failed (${res.status}) for ${path}.`);
+  return res.json() as Promise<T>;
+}
+
+async function callFunction<T>(slug: string, body: unknown): Promise<T> {
+  if (!SUPABASE_URL || !SUPABASE_ANON_KEY) throw new Error("Supabase is not configured.");
+  const res = await fetch(`${SUPABASE_URL}/functions/v1/${slug}`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json", apikey: SUPABASE_ANON_KEY, Authorization: `Bearer ${SUPABASE_ANON_KEY}` },
+    body: JSON.stringify(body),
+  });
+  const data = await res.json().catch(() => ({}) as Record<string, unknown>);
+  if (!res.ok) {
+    const message = typeof (data as Record<string, unknown>)?.error === "string" ? (data as Record<string, unknown>).error : `${slug} failed (${res.status}).`;
+    throw new Error(message as string);
+  }
+  return data as T;
+}
+
+// Appends one manually-typed requirement to an existing buyer via the same
+// save-buyer-requirements tool the workflow itself uses — so a requirement
+// added from the Requirements page is real, not a local-only fake row.
+export async function addBuyerRequirement(buyerId: string, text: string): Promise<{ id: string; text: string }> {
+  const result = await callFunction<{ savedRequirementIds: string[]; requirements: { id: string; requirement_text: string }[] }>(
+    "save-buyer-requirements",
+    { buyerId, requirements: [{ text, priority: "medium", source: "buyer_input" }] }
+  );
+  const saved = result.requirements[0];
+  return { id: saved?.id ?? "", text: saved?.requirement_text ?? text };
+}
+
+// ---------------------------------------------------------------------------
+// Buyer identity
+// ---------------------------------------------------------------------------
+
+export async function getBuyer(buyerId: string): Promise<Buyer | null> {
+  const rows = await restGet<Record<string, unknown>[]>(
+    `buyers?id=eq.${buyerId}&select=id,company_name,industry,company_size,contact_name,contact_role,created_at&limit=1`
+  );
+  const b = rows[0];
+  if (!b) return null;
+  return {
+    id: b.id as string,
+    companyName: (b.company_name as string) ?? "",
+    industry: (b.industry as string) ?? "",
+    companySize: (b.company_size as number) ?? 0,
+    createdAt: b.created_at as string,
+    contactName: (b.contact_name as string) ?? "",
+    contactRole: (b.contact_role as string) ?? "",
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Requirements + Client Reality Profile
+// ---------------------------------------------------------------------------
+
+export async function getBuyerRequirements(buyerId: string) {
+  const rows = await restGet<Record<string, unknown>[]>(
+    `buyer_requirements?buyer_id=eq.${buyerId}&select=id,requirement_text,priority,status,source&order=created_at.desc`
+  );
+  return rows.map((r) => ({
+    id: r.id as string,
+    text: r.requirement_text as string,
+    priority: r.priority as "high" | "medium" | "low",
+    status: r.status as "captured" | "clarifying" | "confirmed",
+    source: r.source as "buyer_input" | "ai_inferred",
+  }));
+}
+
+export async function getClientRealityProfile(buyerId: string): Promise<ClientRealityProfile | null> {
+  const rows = await restGet<Record<string, unknown>[]>(
+    `client_reality_profiles?buyer_id=eq.${buyerId}&select=*&limit=1`
+  );
+  const p = rows[0];
+  if (!p) return null;
+  return {
+    buyerId,
+    currentTechnology: (p.current_technology as string[]) ?? [],
+    currentCostAnnual: Number(p.current_cost_annual ?? 0),
+    users: (p.users as number) ?? 0,
+    processes: (p.processes as string[]) ?? [],
+    painPoints: (p.pain_points as string[]) ?? [],
+    goals: (p.goals as string[]) ?? [],
+    constraints: (p.constraints as string[]) ?? [],
+    timelineMonths: (p.timeline_months as number) ?? 0,
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Vendors
+// ---------------------------------------------------------------------------
+
+function mapVendorRow(v: Record<string, unknown>, fitScore?: number | null, keyMatch?: string | null): Vendor {
+  return {
+    id: v.id as string,
+    name: (v.company_name as string) ?? "",
+    slug: (v.slug as string) ?? (v.id as string),
+    website: (v.website as string) ?? "",
+    industry: (v.industry as string) ?? "",
+    description: (v.description as string) ?? "",
+    tagline: (v.tagline as string) ?? "",
+    verificationStatus: (v.verification_status as Vendor["verificationStatus"]) ?? "pending",
+    employeeRange: (v.employee_range as string) ?? "",
+    hq: (v.hq as string) ?? "",
+    foundedYear: (v.founded_year as number) ?? 0,
+    color: (v.color as string) ?? "brand",
+    fitScore: fitScore != null ? Math.round(Number(fitScore)) : undefined,
+    keyMatch: keyMatch ?? undefined,
+    industries: (v.industries as string[]) ?? [],
+  };
+}
+
+// All vendors the Solution Matching Agent ranked for this buyer (Recommend
+// Vendors -> Query All Published Vendor Solution DNA -> Save Vendor
+// Recommendation Ranking), sorted by fit score.
+export async function getRecommendedVendors(buyerId: string): Promise<Vendor[]> {
+  const recs = await restGet<Record<string, unknown>[]>(
+    `vendor_recommendations?buyer_id=eq.${buyerId}&select=vendor_id,fit_score,key_match&order=fit_score.desc`
+  );
+  if (recs.length === 0) return [];
+  const vendorIds = [...new Set(recs.map((r) => r.vendor_id as string))];
+  const vendors = await restGet<Record<string, unknown>[]>(
+    `vendors?id=in.(${vendorIds.join(",")})&select=id,company_name,slug,website,industry,description,tagline,employee_range,hq,founded_year,color,industries,verification_status`
+  );
+  const byId = new Map(vendors.map((v) => [v.id as string, v]));
+  return recs
+    .map((r) => {
+      const v = byId.get(r.vendor_id as string);
+      return v ? mapVendorRow(v, r.fit_score as number | null, r.key_match as string | null) : null;
+    })
+    .filter((v): v is Vendor => v !== null);
+}
+
+export async function getVendorById(vendorId: string): Promise<Vendor | null> {
+  const rows = await restGet<Record<string, unknown>[]>(`vendors?id=eq.${vendorId}&select=*`);
+  const v = rows[0];
+  return v ? mapVendorRow(v) : null;
+}
+
+export async function getVendorBySlugOrId(idOrSlug: string): Promise<Vendor | null> {
+  const bySlug = await restGet<Record<string, unknown>[]>(`vendors?slug=eq.${idOrSlug}&select=*&limit=1`);
+  if (bySlug[0]) return mapVendorRow(bySlug[0]);
+  const byId = await restGet<Record<string, unknown>[]>(`vendors?id=eq.${idOrSlug}&select=*&limit=1`);
+  return byId[0] ? mapVendorRow(byId[0]) : null;
+}
+
+// The buyer's currently active vendor selection (Confirm Vendor Selection ->
+// Save Selected Vendor Context).
+export async function getActiveVendorSelection(buyerId: string): Promise<string | null> {
+  const rows = await restGet<Record<string, unknown>[]>(
+    `buyer_vendor_selections?buyer_id=eq.${buyerId}&is_active=eq.true&select=vendor_id&order=selected_at.desc&limit=1`
+  );
+  return rows[0] ? (rows[0].vendor_id as string) : null;
+}
+
+// Published capabilities for a vendor's profile page, with evidence —
+// mirrors the shape dummy-data.ts's `capabilities` array uses.
+export async function getVendorCapabilities(vendorId: string) {
+  const caps = await restGet<Record<string, unknown>[]>(
+    `solution_capabilities?vendor_id=eq.${vendorId}&select=id,name,description,category,verification_status,tags&order=created_at.asc`
+  );
+  if (caps.length === 0) return [];
+  const capIds = caps.map((c) => c.id as string);
+  const evidence = await restGet<Record<string, unknown>[]>(
+    `solution_evidence?capability_id=in.(${capIds.join(",")})&select=capability_id,source_label,source_type,source_text`
+  );
+  const evidenceByCapId = new Map<string, Record<string, unknown>[]>();
+  for (const e of evidence) {
+    const key = e.capability_id as string;
+    if (!evidenceByCapId.has(key)) evidenceByCapId.set(key, []);
+    evidenceByCapId.get(key)!.push(e);
+  }
+  return caps.map((c) => ({
+    id: c.id as string,
+    vendorId,
+    name: (c.name as string) ?? "",
+    description: (c.description as string) ?? "",
+    category: c.category as string,
+    verificationStatus: c.verification_status as string,
+    evidence: (evidenceByCapId.get(c.id as string) ?? []).map((e) => ({
+      sourceLabel: (e.source_label as string) ?? "Source",
+      sourceType: (e.source_type as string) ?? "other",
+      snippet: (e.source_text as string) ?? "",
+    })),
+    tags: (c.tags as string[]) ?? [],
+  }));
+}
+
+// ---------------------------------------------------------------------------
+// Solution model (matches, gaps, ROI)
+// ---------------------------------------------------------------------------
+
+export async function getSolutionModel(buyerId: string, vendorId: string): Promise<SolutionModel | null> {
+  const models = await restGet<Record<string, unknown>[]>(
+    `solution_models?buyer_id=eq.${buyerId}&vendor_id=eq.${vendorId}&select=*&order=version.desc&limit=1`
+  );
+  const m = models[0];
+  if (!m) return null;
+
+  const [roiRows, matchRows, gapRows] = await Promise.all([
+    restGet<Record<string, unknown>[]>(`roi_projections?solution_model_id=eq.${m.id}&select=*&limit=1`),
+    restGet<Record<string, unknown>[]>(`solution_matches?solution_model_id=eq.${m.id}&select=*`),
+    restGet<Record<string, unknown>[]>(`gap_items?solution_model_id=eq.${m.id}&select=*`),
+  ]);
+
+  const roiRow = roiRows[0];
+  const roi: RoiProjection = roiRow
+    ? {
+        currentAnnualCost: Number(roiRow.current_annual_cost ?? 0),
+        projectedAnnualCost: Number(roiRow.projected_annual_cost ?? 0),
+        savingsPercent: Number(roiRow.savings_percent ?? 0),
+        paybackMonths: Number(roiRow.payback_months ?? 0),
+        threeYearSavings: Number(roiRow.three_year_savings ?? 0),
+        chart: Array.isArray(roiRow.chart) ? (roiRow.chart as RoiProjection["chart"]) : [],
+      }
+    : { currentAnnualCost: 0, projectedAnnualCost: 0, savingsPercent: 0, paybackMonths: 0, threeYearSavings: 0, chart: [] };
+
+  const matches: SolutionMatch[] = matchRows.map((mm) => ({
+    id: mm.id as string,
+    requirementText: (mm.requirement_text as string) ?? "",
+    capabilityId: (mm.capability_id as string) ?? "",
+    capabilityName: (mm.capability_name as string) ?? "",
+    matchStatus: mm.match_status as SolutionMatch["matchStatus"],
+    confidence: Number(mm.confidence ?? 0),
+    reasoning: (mm.reasoning as string) ?? "",
+  }));
+
+  const gaps: GapItem[] = gapRows.map((g) => ({
+    id: g.id as string,
+    current: (g.current_state as string) ?? "",
+    desired: (g.desired_state as string) ?? "",
+    gap: (g.gap as string) ?? "",
+    severity: g.severity as GapItem["severity"],
+  }));
+
+  return {
+    id: m.id as string,
+    buyerId,
+    vendorId,
+    version: (m.version as number) ?? 1,
+    status: m.status as SolutionModel["status"],
+    executiveSummary: (m.executive_summary as string) ?? "",
+    matches,
+    gaps,
+    roi,
+    updatedAt: m.updated_at as string,
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Capability frontier / handoff
+// ---------------------------------------------------------------------------
+
+export async function getCapabilityFrontier(buyerId: string): Promise<CapabilityFrontierItem[]> {
+  const rows = await restGet<Record<string, unknown>[]>(
+    `capability_frontier?buyer_id=eq.${buyerId}&select=*&order=created_at.desc`
+  );
+  if (rows.length === 0) return [];
+  const vendorIds = [...new Set(rows.map((r) => r.vendor_id as string).filter(Boolean))];
+  const vendors = vendorIds.length
+    ? await restGet<Record<string, unknown>[]>(`vendors?id=in.(${vendorIds.join(",")})&select=id,company_name`)
+    : [];
+  const vendorNameById = new Map(vendors.map((v) => [v.id as string, v.company_name as string]));
+  const buyer = await getBuyer(buyerId);
+
+  return rows.map((r) => ({
+    id: r.id as string,
+    buyerId,
+    buyerName: buyer?.companyName ?? "",
+    vendorId: (r.vendor_id as string) ?? "",
+    vendorName: vendorNameById.get(r.vendor_id as string) ?? "",
+    question: (r.question as string) ?? "",
+    requirement: (r.requirement as string) ?? "",
+    context: (r.context as string) ?? "",
+    evidenceChecked: (r.evidence_checked as string[]) ?? [],
+    reasonUnresolved: (r.reason_unresolved as string) ?? "",
+    status: r.status as CapabilityFrontierItem["status"],
+    recommendedExpert: (r.recommended_expert as string) ?? "",
+    createdAt: r.created_at as string,
+    vendorResponse: (r.vendor_response as string) ?? undefined,
+  }));
+}
+
+export async function getMeetingRequests(buyerId: string): Promise<MeetingRequest[]> {
+  const rows = await restGet<Record<string, unknown>[]>(
+    `meeting_requests?buyer_id=eq.${buyerId}&select=*&order=created_at.desc`
+  );
+  if (rows.length === 0) return [];
+  const vendorIds = [...new Set(rows.map((r) => r.vendor_id as string).filter(Boolean))];
+  const vendors = vendorIds.length
+    ? await restGet<Record<string, unknown>[]>(`vendors?id=in.(${vendorIds.join(",")})&select=id,company_name`)
+    : [];
+  const vendorNameById = new Map(vendors.map((v) => [v.id as string, v.company_name as string]));
+  const buyer = await getBuyer(buyerId);
+
+  return rows.map((r) => ({
+    id: r.id as string,
+    buyerName: buyer?.companyName ?? "",
+    vendorName: vendorNameById.get(r.vendor_id as string) ?? "",
+    status: r.status as MeetingRequest["status"],
+    unresolvedCount: (r.unresolved_count as number) ?? 0,
+    proposedDate: (r.proposed_date as string) ?? undefined,
+    expert: (r.expert as string) ?? "",
+  }));
+}
+
+// ---------------------------------------------------------------------------
+// Chat / conversation history
+// ---------------------------------------------------------------------------
+
+export async function getConversationMessages(buyerId: string, vendorId?: string): Promise<ConversationMessage[]> {
+  const convParams = new URLSearchParams({
+    buyer_id: `eq.${buyerId}`,
+    select: "id",
+    order: "created_at.desc",
+    limit: "1",
+  });
+  if (vendorId) convParams.set("vendor_id", `eq.${vendorId}`);
+  const conversations = await restGet<Record<string, unknown>[]>(`conversations?${convParams}`);
+  const conversationId = conversations[0]?.id as string | undefined;
+  if (!conversationId) return [];
+
+  const rows = await restGet<Record<string, unknown>[]>(
+    `messages?conversation_id=eq.${conversationId}&select=*&order=created_at.asc`
+  );
+  return rows
+    .filter((r) => r.role === "user" || r.role === "assistant")
+    .map((r) => ({
+      id: r.id as string,
+      role: r.role as ConversationMessage["role"],
+      content: (r.content as string) ?? "",
+      responseStatus: (r.response_status as ConversationMessage["responseStatus"]) ?? undefined,
+      evidence: (r.evidence as ConversationMessage["evidence"]) ?? undefined,
+      assumptions: (r.assumptions as string[]) ?? undefined,
+      createdAt: r.created_at as string,
+    }));
+}
+
+// ---------------------------------------------------------------------------
+// Solution deck (Generate Solution Pitch Deck -> Save Buyer Solution Deck)
+// ---------------------------------------------------------------------------
+
+// Buyer requests a meeting with the vendor's Solutions Team over the still-
+// open Capability Frontier items — the real "Handoff" tool
+// (schedule-vendor-discussion). The vendor side later calls
+// confirm-vendor-discussion-meeting to move it to "scheduled"; from the
+// buyer's chair this always lands as "requested".
+export async function scheduleVendorDiscussion(params: {
+  buyerId: string;
+  vendorId: string;
+  frontierItemIds: string[];
+  proposedDate?: string;
+  expert?: string;
+}): Promise<{ meetingRequestId: string; status: string; proposedDate: string | null; expert: string | null }> {
+  return callFunction("schedule-vendor-discussion", params);
+}
+
+export interface BuyerSolutionDeck {
+  title: string;
+  pptxUrl: string;
+  status: "ready" | "failed";
+}
+
+export async function getBuyerSolutionDeck(buyerId: string): Promise<BuyerSolutionDeck | null> {
+  const rows = await restGet<Record<string, unknown>[]>(
+    `buyer_solution_decks?buyer_id=eq.${buyerId}&select=title,pptx_url,status&order=created_at.desc&limit=1`
+  );
+  const d = rows[0];
+  if (!d || !d.pptx_url) return null;
+  return { title: (d.title as string) ?? "Your solution deck", pptxUrl: d.pptx_url as string, status: d.status as "ready" | "failed" };
+}
