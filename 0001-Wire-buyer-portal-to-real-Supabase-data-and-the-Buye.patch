+// Client-side hand-off of buyer.id between the Discover intake form and the
+// rest of the buyer portal, mirroring vendor-session.ts. The "Understand
+// Buyer Requirement" milestone's "Capture Initial Requirement Summary" tool
+// (save-buyer-requirements) finds-or-creates the buyer row by companyName,
+// so once that first trigger call lands we look the row up and remember its
+// id here for every later page/read.
+const STORAGE_KEY = "deckless-pitch:buyer-id";
+const NAME_STORAGE_KEY = "deckless-pitch:buyer-name";
+
+export function getStoredBuyerId(): string | null {
+  if (typeof window === "undefined") return null;
+  return window.localStorage.getItem(STORAGE_KEY);
+}
+
+export function setStoredBuyerId(buyerId: string) {
+  if (typeof window === "undefined") return;
+  window.localStorage.setItem(STORAGE_KEY, buyerId);
+}
+
+export function clearStoredBuyerId() {
+  if (typeof window === "undefined") return;
+  window.localStorage.removeItem(STORAGE_KEY);
+  window.localStorage.removeItem(NAME_STORAGE_KEY);
+}
+
+// Company name (and contact) of the registered buyer, so the portal shell
+// can reflect who's actually signed in instead of the hardcoded "Priya
+// Sharma / Meridian Retail Group" demo placeholder.
+export function getStoredBuyerName(): string | null {
+  if (typeof window === "undefined") return null;
+  return window.localStorage.getItem(NAME_STORAGE_KEY);
+}
+
+export function setStoredBuyerName(companyName: string) {
+  if (typeof window === "undefined") return;
+  window.localStorage.setItem(NAME_STORAGE_KEY, companyName);
+}
+
+const CONTACT_NAME_KEY = "deckless-pitch:buyer-contact-name";
+
+export function getStoredBuyerContactName(): string | null {
+  if (typeof window === "undefined") return null;
+  return window.localStorage.getItem(CONTACT_NAME_KEY);
+}
+
+export function setStoredBuyerContactName(contactName: string) {
+  if (typeof window === "undefined") return;
+  window.localStorage.setItem(CONTACT_NAME_KEY, contactName);
+}
+
+// A submission the workflow hasn't finished yet, persisted so the buyer
+// id can still be found even if the buyer navigates away (or reloads)
+// before the discover page's own poll finds the result — the poll dies
+// with the component on unmount, same reasoning as vendor-session.ts.
+const PENDING_KEY = "deckless-pitch:buyer-pending-submission";
+
+export interface PendingBuyerSubmission {
+  companyName: string;
+  afterIso: string;
+  deadline: number;
+}
+
+export function getPendingBuyerSubmission(): PendingBuyerSubmission | null {
+  if (typeof window === "undefined") return null;
+  const raw = window.localStorage.getItem(PENDING_KEY);
+  if (!raw) return null;
+  try {
+    return JSON.parse(raw) as PendingBuyerSubmission;
+  } catch {
+    return null;
+  }
+}
+
+export function setPendingBuyerSubmission(pending: PendingBuyerSubmission) {
+  if (typeof window === "undefined") return;
+  window.localStorage.setItem(PENDING_KEY, JSON.stringify(pending));
+}
+
+export function clearPendingBuyerSubmission() {
+  if (typeof window === "undefined") return;
+  window.localStorage.removeItem(PENDING_KEY);
+}
