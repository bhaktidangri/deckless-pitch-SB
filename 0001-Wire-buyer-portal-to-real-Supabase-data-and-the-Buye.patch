@@ -0,0 +1,57 @@
+import { NextResponse } from "next/server";
+import { triggerBuyerRequirementSubmission, YoxaTriggerError } from "@/lib/api/yoxa-trigger";
+
+interface SubmissionBody {
+  companyName?: string;
+  industry?: string;
+  companySize?: number;
+  contactName?: string;
+  contactRole?: string;
+  requirementText?: string;
+}
+
+// Server-side trigger for buyer_requirement_submission. Kept server-only
+// because YOXA_BUYER_DEPLOYMENT_SECRET must not reach the browser.
+//
+// This is the fix for the workflow's very first tool call
+// ("Capture Initial Requirement Summary" -> save-buyer-requirements) 400ing
+// with "companyName or buyerId is required": that tool only ever receives
+// what the conversation has established by the time it fires, and the
+// Buyer Discovery agent doesn't ask for company identity on its own. Rather
+// than rely on the agent to remember, we collect companyName (and the rest
+// of the buyer's identity) in a real form up front and put it directly into
+// trigger_text — the same pattern vendor-source-submission/route.ts already
+// uses to guarantee companyName is never null on Milestone 1's first call.
+export async function POST(req: Request) {
+  const body = (await req.json().catch(() => ({}))) as SubmissionBody;
+
+  if (!body.companyName?.trim()) {
+    return NextResponse.json({ error: "Company name is required." }, { status: 400 });
+  }
+  if (!body.requirementText?.trim()) {
+    return NextResponse.json({ error: "Describe at least one requirement to get started." }, { status: 400 });
+  }
+
+  const lines: string[] = [];
+  lines.push(`Company name: ${body.companyName.trim()}`);
+  if (body.industry) lines.push(`Industry: ${body.industry}`);
+  if (typeof body.companySize === "number" && body.companySize > 0) lines.push(`Company size: ${body.companySize} employees`);
+  if (body.contactName) lines.push(`Contact name: ${body.contactName}`);
+  if (body.contactRole) lines.push(`Contact role: ${body.contactRole}`);
+  lines.push(`Primary requirement: ${body.requirementText.trim()}`);
+  lines.push(
+    "When calling Capture Initial Requirement Summary, pass the company name, industry, company size, contact name, and contact role above exactly as given — do not leave them null."
+  );
+
+  const triggerText = lines.join("\n").trim();
+
+  try {
+    const result = await triggerBuyerRequirementSubmission(triggerText);
+    return NextResponse.json(result, { status: 202 });
+  } catch (e) {
+    if (e instanceof YoxaTriggerError) {
+      return NextResponse.json({ error: e.message, code: e.code }, { status: e.status === 503 ? 503 : 502 });
+    }
+    return NextResponse.json({ error: "Could not submit to the buyer workflow trigger." }, { status: 502 });
+  }
+}
