+// Shared buyer-workflow-completion polling, mirroring vendor-poll.ts. The
+// Buyer Discovery To Handoff workflow runs its full pipeline (Understand ->
+// Recommend -> Confirm -> Build Profile -> Assess -> Generate Deck ->
+// Scenarios -> Handoff) inside one trigger call, so there are two signals
+// worth waiting for: the buyer row existing (fast — created on the very
+// first tool call) and the solution deck being ready (slow — the last step
+// in the pipeline). The Discover page only waits on the first signal so the
+// buyer isn't stuck on a spinner for minutes; the Solution Workspace page
+// waits on the second.
+
+import { countBuyerRequirements, findBuyerCreatedAfter, hasSolutionDeck } from "@/lib/api/buyer-lookup";
+
+export const POLL_INTERVAL_MS = 4000;
+export const BUYER_POLL_TIMEOUT_MS = 90 * 1000;
+export const DECK_POLL_TIMEOUT_MS = 6 * 60 * 1000;
+
+export interface PollHandle {
+  cancel: () => void;
+}
+
+export function pollForNewBuyerId(
+  companyName: string,
+  afterIso: string,
+  deadline: number,
+  onFound: (buyerId: string) => void,
+  onTimeout: () => void
+): PollHandle {
+  let cancelled = false;
+
+  async function tick() {
+    if (cancelled) return;
+    try {
+      const buyer = await findBuyerCreatedAfter(companyName, afterIso);
+      if (buyer) {
+        if (!cancelled) onFound(buyer.id);
+        return;
+      }
+    } catch {
+      // transient read error — keep polling until the deadline
+    }
+    if (cancelled) return;
+    if (Date.now() >= deadline) {
+      onTimeout();
+      return;
+    }
+    setTimeout(tick, POLL_INTERVAL_MS);
+  }
+
+  tick();
+  return { cancel: () => { cancelled = true; } };
+}
+
+export function pollForNewBuyerRequirements(
+  buyerId: string,
+  baseline: number,
+  deadline: number,
+  onFound: () => void,
+  onTimeout: () => void
+): PollHandle {
+  let cancelled = false;
+
+  async function tick() {
+    if (cancelled) return;
+    try {
+      const count = await countBuyerRequirements(buyerId);
+      if (count > baseline) {
+        if (!cancelled) onFound();
+        return;
+      }
+    } catch {
+      // transient read error — keep polling until the deadline
+    }
+    if (cancelled) return;
+    if (Date.now() >= deadline) {
+      onTimeout();
+      return;
+    }
+    setTimeout(tick, POLL_INTERVAL_MS);
+  }
+
+  tick();
+  return { cancel: () => { cancelled = true; } };
+}
+
+export function pollForSolutionDeck(
+  buyerId: string,
+  deadline: number,
+  onFound: () => void,
+  onTimeout: () => void
+): PollHandle {
+  let cancelled = false;
+
+  async function tick() {
+    if (cancelled) return;
+    try {
+      const ready = await hasSolutionDeck(buyerId);
+      if (ready) {
+        if (!cancelled) onFound();
+        return;
+      }
+    } catch {
+      // transient read error — keep polling until the deadline
+    }
+    if (cancelled) return;
+    if (Date.now() >= deadline) {
+      onTimeout();
+      return;
+    }
+    setTimeout(tick, POLL_INTERVAL_MS);
+  }
+
+  tick();
+  return { cancel: () => { cancelled = true; } };
+}
